{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scorobogach/Academic-work/schemas/journal-record.schema.json",
  "title": "JournalRecord",
  "description": "Одна запись append-only журнала. Хранится как одна JSON-строка в journal/YYYY-MM.jsonl.",
  "type": "object",
  "required": ["v", "id", "ts", "session", "project", "actor", "type", "payload", "prev", "hash"],
  "additionalProperties": false,
  "properties": {
    "v": { "type": "integer", "minimum": 1, "description": "Версия формата" },
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "description": "ULID" },
    "ts": { "type": "string", "format": "date-time", "description": "UTC, миллисекунды, ISO-8601" },
    "session": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "actor": {
      "type": "string",
      "pattern": "^(human|agent:[a-z0-9-]+|tool:[a-z0-9-]+|script:[a-z0-9-]+)$"
    },
    "type": {
      "type": "string",
      "enum": ["message", "tool_call", "tool_result", "file", "claim", "evidence",
               "decision", "gate_run", "note", "signoff"]
    },
    "refs": {
      "type": "object",
      "description": "Ссылки на другие объекты",
      "additionalProperties": true,
      "properties": {
        "parent": { "type": "string" },
        "artifact": { "type": "string", "description": "sha256:..." },
        "claim_id": { "type": "string" },
        "source_id": { "type": "string" },
        "gate_run_id": { "type": "string" }
      }
    },
    "payload": { "type": "object", "description": "Смысл события" },
    "prev": { "type": "string", "description": "hex sha256 предыдущей записи; у первой — пустая строка" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "notes": [
    "hash = sha256(canonical_json(record без поля hash)), каноническая форма: sort_keys, separators=(',',':'), ensure_ascii=False, UTF-8",
    "prev = hash предыдущей записи; нарушение цепочки обнаруживается командой verify"
  ]
}
